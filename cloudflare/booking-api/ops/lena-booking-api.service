[Unit]
Description=Lena Bahri booking API
After=network.target

[Service]
Type=simple
User=lenaapi
Group=lenaapi
WorkingDirectory=/opt/lena/booking-api
EnvironmentFile=/etc/lena-booking-api.env
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node /opt/lena/booking-api/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/lena-booking-api
MemoryMax=768M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
